#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail=0
note() { printf '%s\n' "$*" >&2; }

mapfile -d '' staged < <(git diff --cached --name-only -z --diff-filter=ACMR)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

# Private-path / credential markers. The hook is exempt from scanning itself.
# Local project/crew names and fixed profile counts come from an ignored private
# denylist so the public hook itself stays neutral.
private_re='(/home/[A-Za-z0-9._-]+/|/Users/[A-Za-z0-9._-]+/|192\.168\.[0-9]+\.[0-9]+|10\.10\.10\.[0-9]+|GITHUB_TOKEN|ghp_[A-Za-z0-9]+|github_pat_[A-Za-z0-9_]+|BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY)'
profile_count_re='([0-9]+[[:space:]]+profiles?|profiles?[[:space:]]*:[[:space:]]*[0-9]+)'
local_denylist="$ROOT/.private-sanitize.txt"
local_names=()
if [ -f "$local_denylist" ]; then
  while IFS= read -r name; do
    [ -n "$name" ] && local_names+=("$name")
  done < "$local_denylist"
fi

for path in "${staged[@]}"; do
  case "$path" in
    .githooks/*) continue ;;
  esac
  content="$(git show ":$path" 2>/dev/null || true)"
  if printf '%s\n' "$content" | grep -nEI "$private_re"; then
    note "sanitization ERROR: private/local marker found in $path"
    fail=1
  fi
  if printf '%s\n' "$content" | grep -nEi "$profile_count_re"; then
    note "sanitization ERROR: fixed profile count found in $path"
    fail=1
  fi
  for name in "${local_names[@]}"; do
    if printf '%s\n' "$content" | grep -Fwq -- "$name"; then
      note "sanitization ERROR: local example '$name' found in $path"
      fail=1
    fi
  done
done

# Tests are local-only: they must never be committed or pushed to GitHub.
if printf '%s\n' "${staged[@]}" | grep -Eq '(^|/)tests?/|\.test\.mjs$|\.spec\.mjs$'; then
  note 'tests ERROR: tests are local-only and must not be committed to this repository'
  fail=1
fi

# Version consistency across the public release surface.
plugin_version="$(sed -n 's/^version: "\(.*\)"/\1/p' plugin.yaml | head -n 1)"
package_version="$(node -p "require('./stage/package.json').version")"
lock_version="$(node -p "require('./stage/package-lock.json').version")"
lock_root_version="$(node -p "require('./stage/package-lock.json').packages[''].version")"
entry_version="$(grep -o "STAGE_VERSION = '[^']*'" stage/entry.mjs | head -n 1 | sed "s/STAGE_VERSION = '//; s/'//")"
readme_version="$(grep -o 'Current release: \*\*[^*]*\*\*' README.md | head -n 1 | sed 's/Current release: \*\*//; s/\*\*//')"

check_version() {
  local label="$1" value="$2"
  if [ "$value" != "$plugin_version" ]; then
    note "docs/version ERROR: $label is '$value', plugin.yaml is '$plugin_version'"
    fail=1
  fi
}
check_version 'stage/package.json' "$package_version"
check_version 'stage/package-lock.json' "$lock_version"
check_version 'stage/package-lock.json packages[""].version' "$lock_root_version"
check_version 'stage/entry.mjs STAGE_VERSION' "$entry_version"
check_version 'README.md current version' "$readme_version"

# Changelog is a required release surface, linked from the README and documented.
if [ ! -f CHANGELOG.md ]; then
  note 'changelog ERROR: CHANGELOG.md is missing'
  fail=1
fi
if ! grep -qF 'CHANGELOG.md' README.md; then
  note 'changelog ERROR: README.md must link to CHANGELOG.md'
  fail=1
fi
if ! grep -qF 'CHANGELOG.md' docs/development.md; then
  note 'changelog ERROR: docs/development.md must document CHANGELOG.md'
  fail=1
fi

# The GitHub-facing README must stay a new-user guide, and the docs tree must
# exist and be linked from it.
required_docs=(
  docs/index.md
  docs/getting-started.md
  docs/using-stage.md
  docs/configuration.md
  docs/architecture.md
  docs/development.md
  docs/security.md
)
for doc in "${required_docs[@]}"; do
  if [ ! -f "$doc" ]; then
    note "docs ERROR: required documentation file missing: $doc"
    fail=1
  fi
  if ! grep -qF "$doc" README.md; then
    note "docs ERROR: README.md must link to $doc"
    fail=1
  fi
done

if ! grep -q '^## Quick start' README.md; then
  note 'docs ERROR: README.md must keep a new-user Quick start section'
  fail=1
fi
if ! grep -q '^## Documentation' README.md; then
  note 'docs ERROR: README.md must keep a Documentation section'
  fail=1
fi

# Features belong in the docs tree, not as changelist entries in the README.
if ! grep -Rq 'pass_ack' docs; then
  note 'docs ERROR: docs must document branding.pass_ack'
  fail=1
fi
if ! grep -Rq 'Mentions are highlighted' docs; then
  note 'docs ERROR: docs must document blue mention styling'
  fail=1
fi
if ! grep -Rq 'Tool-call' docs; then
  note 'docs ERROR: docs must document tool-call styling'
  fail=1
fi

# The Hermes catalog release path is a durable project process, not a one-off.
if [ ! -x scripts/hermes-catalog-pr.sh ]; then
  note 'docs ERROR: scripts/hermes-catalog-pr.sh must exist and be executable'
  fail=1
fi
if ! grep -q 'hermes-catalog-pr.sh' docs/development.md; then
  note 'docs ERROR: docs/development.md must document scripts/hermes-catalog-pr.sh'
  fail=1
fi

# Code changes must carry both a README update and a docs update in the same commit.
if printf '%s\n' "${staged[@]}" | grep -qE '^(stage/|plugin\.yaml$)'; then
  if ! printf '%s\n' "${staged[@]}" | grep -qx 'README.md'; then
    note 'docs ERROR: code changes require README.md staged in the same commit'
    fail=1
  fi
  if ! printf '%s\n' "${staged[@]}" | grep -q '^docs/'; then
    note 'docs ERROR: code changes require a docs/ update staged in the same commit'
    fail=1
  fi
fi

# Code, release-surface, script, and hook changes must carry a changelog update.
if printf '%s\n' "${staged[@]}" | grep -qE '^(stage/|plugin\.yaml$|scripts/|\.githooks/)'; then
  if ! printf '%s\n' "${staged[@]}" | grep -qx 'CHANGELOG.md'; then
    note 'changelog ERROR: code changes require CHANGELOG.md staged in the same commit'
    fail=1
  fi
fi

# A version bump must have a matching changelog entry.
previous_plugin_version="$(git show HEAD:plugin.yaml 2>/dev/null | sed -n 's/^version: "\(.*\)"/\1/p' | head -n 1 || true)"
if [ -n "$previous_plugin_version" ] && [ "$plugin_version" != "$previous_plugin_version" ]; then
  changelog_staged="$(git show :CHANGELOG.md 2>/dev/null || true)"
  if ! printf '%s\n' "$changelog_staged" | grep -qF "## [$plugin_version]"; then
    note "changelog ERROR: no entry for version $plugin_version in CHANGELOG.md"
    fail=1
  fi
fi

# Code changes must keep the workspace GOAL.md (the design source of truth) at
# least as new as the code they touch. Public clones have no workspace tree, so
# the guard is local-only.
if printf '%s\n' "${staged[@]}" | grep -qE '^stage/[^/]+\.mjs$'; then
  goal_sync="${HERMES_STAGE_GOAL_SYNC:-$HOME/.hermes/workspace/hermes-stage/scripts/check-goal-sync.sh}"
  if [ -x "$goal_sync" ]; then
    if ! STAGE_CODE_DIR="$ROOT/stage" "$goal_sync"; then
      fail=1
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  note 'pre-commit: sanitization/docs gate failed; fix the files instead of bypassing with --no-verify.'
  exit 1
fi

exit 0
