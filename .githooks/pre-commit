#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail=0
note() { printf '%s\n' "$*" >&2; }

mapfile -d '' staged < <(git diff --cached --name-only -z --diff-filter=ACMR)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

# Private-path / credential markers. The hook is exempt from scanning itself.
private_re='(/home/[A-Za-z0-9._-]+/|/Users/[A-Za-z0-9._-]+/|192\.168\.[0-9]+\.[0-9]+|10\.10\.10\.[0-9]+|\b(wrx80e|furnace|x10dri)\b|\bArchitect\b|GITHUB_TOKEN|ghp_[A-Za-z0-9]+|github_pat_[A-Za-z0-9_]+|BEGIN (RSA|OPENSSH|EC|DSA) PRIVATE KEY)'

for path in "${staged[@]}"; do
  case "$path" in
    .githooks/*) continue ;;
  esac
  content="$(git show ":$path" 2>/dev/null || true)"
  if printf '%s\n' "$content" | grep -nEI "$private_re"; then
    note "sanitization ERROR: private/local marker found in $path"
    fail=1
  fi
done

# Version consistency across the public release surface.
plugin_version="$(sed -n 's/^version: "\(.*\)"/\1/p' plugin.yaml | head -n 1)"
package_version="$(node -p "require('./stage/package.json').version")"
lock_version="$(node -p "require('./stage/package-lock.json').version")"
lock_root_version="$(node -p "require('./stage/package-lock.json').packages[''].version")"
entry_version="$(grep -o "STAGE_VERSION = '[^']*'" stage/entry.mjs | head -n 1 | sed "s/STAGE_VERSION = '//; s/'//")"
readme_version="$(grep -o 'Current version: \*\*[^*]*\*\*' README.md | head -n 1 | sed 's/Current version: \*\*//; s/\*\*//')"

check_version() {
  local label="$1" value="$2"
  if [ "$value" != "$plugin_version" ]; then
    note "docs/version ERROR: $label is '$value', plugin.yaml is '$plugin_version'"
    fail=1
  fi
}
check_version 'stage/package.json' "$package_version"
check_version 'stage/package-lock.json' "$lock_version"
check_version 'stage/package-lock.json packages[""].version' "$lock_root_version"
check_version 'stage/entry.mjs STAGE_VERSION' "$entry_version"
check_version 'README.md current version' "$readme_version"

# The GitHub-facing README must document the current UI surface.
if ! grep -q 'pass_ack' README.md; then
  note 'docs ERROR: README.md must document branding.pass_ack'
  fail=1
fi
if ! grep -q 'Mentions are highlighted' README.md; then
  note 'docs ERROR: README.md must document blue mention styling'
  fail=1
fi
if ! grep -q 'Tool-call' README.md; then
  note 'docs ERROR: README.md must document tool-call styling'
  fail=1
fi

# Code changes must carry a staged README update in the same commit.
if printf '%s\n' "${staged[@]}" | grep -qE '^(stage/|plugin\.yaml$)'; then
  if ! printf '%s\n' "${staged[@]}" | grep -qx 'README.md'; then
    note 'docs ERROR: code changes require README.md staged in the same commit'
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  note 'pre-commit: sanitization/docs gate failed; fix the files instead of bypassing with --no-verify.'
  exit 1
fi

exit 0
